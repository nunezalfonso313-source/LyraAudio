<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#111111"
        app:title="LyraAudio"
        app:titleTextColor="#FFFFFF"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Cabecera -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="#111111">

            <ImageView
                android:id="@+id/album_art"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/track_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cargando..."
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:ellipsize="marquee"
                    android:singleLine="true"/>

                <TextView
                    android:id="@+id/track_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#00BFFF"
                    android:textSize="13sp"
                    android:singleLine="true"/>

                <TextView
                    android:id="@+id/track_album"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:singleLine="true"/>

                <TextView
                    android:id="@+id/track_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#00FF00"
                    android:textSize="11sp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Nixie -->
        <com.lyra.audiokernel.NixieDisplayView
            android:id="@+id/nixie_display"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>

        <!-- SeekBar -->
        <SeekBar
            android:id="@+id/seek_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:progressTint="#00BFFF"
            android:thumbTint="#00BFFF"/>

        <!-- Tiempos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/time_current"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="#00FF00"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/track_number"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="#888888"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/time_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="#00FF00"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- Botones de control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_shuffle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⇀"
                android:background="@android:color/transparent"
                android:textColor="#555555"/>

            <Button
                android:id="@+id/btn_prev"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏮"
                android:background="@android:color/transparent"
                android:textColor="#CCCCCC"/>

            <Button
                android:id="@+id/btn_play"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="▶"
                android:textColor="#00FF00"
                android:background="@android:color/transparent"
                android:textSize="22sp"/>

            <Button
                android:id="@+id/btn_next"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏭"
                android:background="@android:color/transparent"
                android:textColor="#CCCCCC"/>

            <Button
                android:id="@+id/btn_repeat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="↺"
                android:background="@android:color/transparent"
                android:textColor="#555555"/>
        </LinearLayout>

        <!-- ListView -->
        <ListView
            android:id="@+id/playlist_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#1A1A1A"
            android:dividerHeight="1dp"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
